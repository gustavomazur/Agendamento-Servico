# ==========================================
# Conexão da aplicação com o PostgreSQL
# (Spring Boot - lido pelo application.properties)
# ==========================================
DATABASE_HOSTNAME=db
DATABASE_PORT=5432
DATABASE_NAME=agendador
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=sua_nova_senha

# ==========================================
# Inicialização do PostgreSQL no Docker
# ==========================================
POSTGRES_DB=agendador
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sua_nova_senha

# ==========================================
# Aplicação (opcional)
# ==========================================
SERVER_PORT=8080

# ==========================================
# Autenticação
# ==========================================
# Client ID do OAuth 2.0 (Google Cloud Console > APIs e serviços > Credenciais)

GOOGLE_CLIENT_ID=seu_client_id_do_google_cloud.apps.googleusercontent.com

# Chave secreta usada para assinar o JWT da aplicação (JJWT - HS256)
# Gere uma forte, ex.: openssl rand -base64 64

JWT_SECRET=sua_chave_secreta_forte

# E-mails com permissão de ADMIN, separados por vírgula (opcional)

ADMIN_EMAILS=admin@email.com
