# ==========================================
# MODELO de configuração
# Copie este arquivo para application.properties antes de rodar o projeto:
#   cp src/main/resources/application.properties-modelo src/main/resources/application.properties
# Os valores entre ${...} são lidos das variáveis de ambiente (veja envs/.env.example)

# ==========================================
# Aplicação
# ==========================================
spring.application.name=agendador-horarios
server.port=${SERVER_PORT:8080}

# ==========================================
# PostgreSQL
# ==========================================
spring.datasource.url=jdbc:postgresql://${DATABASE_HOSTNAME:localhost}:${DATABASE_PORT:5432}/${DATABASE_NAME:agendador}
spring.datasource.username=${DATABASE_USERNAME}
spring.datasource.password=${DATABASE_PASSWORD}
spring.datasource.driver-class-name=org.postgresql.Driver

# ==========================================
# JPA / Hibernate
# ==========================================
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.open-in-view=false

# ==========================================
# Login Google
# ==========================================
google.client-id=${GOOGLE_CLIENT_ID}

# ==========================================
# JWT
# ==========================================
jwt.secret=${JWT_SECRET}
jwt.expiration-ms=3600000

app.admin-emails=${ADMIN_EMAILS:}
